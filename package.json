{
  "name": "worksmart",
  "type": "module",
  "private": true,
  "description": "WorkSmart static site (Cloudflare Pages → public/)",
  "scripts": {
    "dev": "npx --yes serve -p 4173 --no-port-switching public",
    "format": "prettier --write \"**/*.{md,html,css,yml,yaml,json}\"",
    "format:check": "prettier --check \"**/*.{md,html,css,yml,yaml,json}\"",
    "test": "node scripts/run-tests.mjs",
    "content:check": "node scripts/check-content.mjs",
    "ci:local": "npm run format:check && npm run content:check && npm test",
    "pipeline": "node scripts/pipeline.mjs",
    "pipeline:full": "node scripts/pipeline.mjs --auto-merge",
    "pipeline:sync": "node scripts/pipeline.mjs --sync",
    "pipeline:dry": "node scripts/pipeline.mjs --dry-run",
    "pipeline:release": "node scripts/pipeline.mjs --release --auto-merge",
    "doctor:deploy": "node scripts/doctor-deploy.mjs",
    "deploy:prod": "npm run doctor:deploy && node scripts/deploy-pages.mjs --env production",
    "deploy:preview": "node scripts/deploy-pages.mjs --env preview",
    "verify:prod": "node scripts/verify-prod.mjs",
    "inject:analytics-endpoint": "node scripts/inject-analytics-endpoint.mjs",
    "optimize:og": "node scripts/optimize-og-image.mjs",
    "worker:form-analytics:deploy": "npx wrangler deploy --config workers/form-analytics/wrangler.toml",
    "ship": "node scripts/ship.mjs",
    "ship:quick": "node scripts/ship.mjs --quick",
    "ship:open": "node scripts/ship.mjs --open",
    "phase:start": "node scripts/phase-start.mjs",
    "phase:complete": "node scripts/phase-complete.mjs",
    "phase:status": "node scripts/phase-status.mjs",
    "phase:autopilot": "node scripts/phase-autopilot.mjs",
    "pr:sync-merge": "node scripts/pr-sync-merge.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:bundle": "node scripts/release-bundle.mjs",
    "release:closeout": "node scripts/release-closeout.mjs",
    "release:index": "node scripts/release-index.mjs",
    "release:handoff": "node scripts/release-handoff.mjs",
    "release:finalize": "node scripts/release-finalize.mjs",
    "release:latest": "node scripts/release-latest.mjs",
    "release:go-live": "node scripts/release-go-live.mjs",
    "metrics:summary": "node scripts/metrics-summary.mjs",
    "verify:telemetry": "node scripts/verify-telemetry.mjs",
    "doctor:env": "node scripts/doctor-env.mjs",
    "branch:check": "node scripts/branch-check.mjs",
    "readiness:report": "node scripts/readiness-report.mjs",
    "ops:status": "node scripts/ops-status.mjs",
    "ops:watch": "node scripts/ops-watch.mjs",
    "ops:evidence": "node scripts/ops-evidence.mjs",
    "ops:incident-template": "node scripts/ops-incident-template.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.1",
    "sharp": "^0.33.5"
  }
}
